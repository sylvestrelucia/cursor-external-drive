# Copy to ~/.config/cursor-external-drive/config.env and edit.
# Or set these variables in your shell before running scripts.

# Mount point of your external drive (must exist when Cursor starts).
# Use the exact name shown in Finder (e.g. /Volumes/External HD).
CURSOR_EXTERNAL_VOLUME="/Volumes/External HD"

# Root folder on the external drive for all Cursor data.
CURSOR_EXTERNAL_BASE="${CURSOR_EXTERNAL_VOLUME}/CursorCache"

# Folder name for ~/.cursor on the external drive (symlink target).
CURSOR_DOT_CURSOR_DIR="dot-cursor"

# Where scripts are installed (used by install.sh and launchd).
CURSOR_SCRIPTS_DIR="${HOME}/Library/Scripts/cursor-external-drive"

# LaunchAgent label prefix (reverse-DNS, e.g. com.yourname).
CURSOR_LAUNCHD_LABEL="com.example.cursor-external-drive"

# Optional: override auto-detected Cursor app cache folder name under ~/Library/Caches/.
# Auto-detected from /Applications/Cursor.app (CFBundleIdentifier) when unset.
# CURSOR_APP_CACHE_NAME="com.todesktop.XXXXXXXXXX"
